          {
            "construct": "pkl.computed_default",
            "count": 3,
            "detail": "A default that can only be computed from other members, or from the module, has no single value to record. The member is modelled without a default.",
            "locations": [
              "Computed.total",
              "Computed.upper",
              "Conditional.seats"
            ]
          },
          {
            "construct": "pkl.external_read",
            "count": 1,
            "detail": "`read(…)` reads an environment variable, a file or a URL at evaluation time, and the evaluation sandbox refuses every resource. The member is modelled without the value it would have read.",
            "locations": [
              "FromEnvironment.region"
            ]
          },
          {
            "construct": "pkl.generator",
            "count": 1,
            "detail": "A `for` or `when` generator builds a member's value during evaluation. The member's type is modelled; how its value is generated is not.",
            "locations": [
              "Computed.upper"
            ]
          },
          {
            "construct": "pkl.late_binding",
            "count": 1,
            "detail": "A constraint written in terms of another member (`Int(this > minimum)`) is checked against the object it belongs to, at evaluation. The member's type is modelled; the relation is not.",
            "locations": [
              "SelfReferential.maximum"
            ]
          },
          {
            "construct": "pkl.method",
            "count": 1,
            "detail": "A method (`function`) describes behaviour, not data. It is not modelled.",
            "locations": [
              "Stress"
            ]
          },
          {
            "construct": "pkl.output",
            "count": 1,
            "detail": "A module's `output` block decides how the module renders, not what its data is. It is not modelled.",
            "locations": [
              "Stress"
            ]
          },
