      "typescript": {
        "capability_limits": [
          {
            "construct": "typescript.conditional_type",
            "count": 1,
            "detail": "A conditional type (`T extends U ? X : Y`, including `infer`) computes a type from another at compile time. It has no fixed shape to model, so the declaration or member that uses one is left out of the model rather than guessed.",
            "locations": [
              "Unwrap"
            ]
          },
          {
            "construct": "typescript.declaration_merging",
            "count": 1,
            "detail": "Two or more declarations of the same interface merge into one in TypeScript. Merging is outside the supported subset, so a merged interface is left out of the model, and so is any member that refers to it.",
            "locations": [
              "Merged"
            ]
          },
          {
            "construct": "typescript.function_type",
            "count": 2,
            "detail": "A function, constructor or method signature describes behaviour, not data. The declaration or member is left out of the model.",
            "locations": [
              "Factory",
              "Handler"
            ]
          },
          {
            "construct": "typescript.index_signature",
            "count": 1,
            "detail": "An index signature beside named properties (`{ known: string; [key: string]: … }`) describes the extra keys an object may carry. The canonical record has no additional-properties slot, so the signature is recorded in `typescript_index` on the record; an object made only of an index signature is modelled as a map.",
            "locations": [
              "WithIndexSignature"
            ]
          },
          {
            "construct": "typescript.mapped_type",
            "count": 1,
            "detail": "A mapped type (`{ [K in keyof T]: … }`) is a transformation over another type's keys, not a shape of its own. It is left out of the model; `Partial`, `Required`, `Readonly`, `Pick` and `Omit` applied to a concrete type are evaluated and modelled instead.",
            "locations": [
              "Partialised"
            ]
          },
          {
            "construct": "typescript.symbol_key",
            "count": 1,
            "detail": "A member keyed by a symbol (`[brand]: true`, `unique symbol`) has no name a data schema can carry. That member is left out; the rest of its type is modelled.",
            "locations": [
              "Branded.[brand]"
            ]
          },
          {
            "construct": "typescript.template_literal_type",
            "count": 1,
            "detail": "A template literal type (`` `on${Capitalize<…>}` ``) describes a set of strings by computation. The canonical model has no slot for the generated set, so the declaration or member is left out of the model rather than widened to `string`.",
            "locations": [
              "EventName"
            ]
          },
          {
            "construct": "typescript.tuple_positions",
            "count": 2,
            "detail": "A tuple becomes a list whose items are the union of its element types, bounded by its length. Which type sits at which position, and each position's label, is recorded in `typescript_tuple` — preserved and reportable, but not enforced by the canonical list.",
            "locations": [
              "Tuple",
              "VariadicTuple"
            ]
          },
          {
            "construct": "typescript.unresolved_generic",
            "count": 1,
            "detail": "A generic declaration is modelled where it is instantiated — `Page<Order>` becomes a concrete record — and not where it is merely declared. A generic that is never instantiated with concrete arguments, or a type parameter that reaches the model unbound, has no shape to record and is declared here.",
            "locations": [
              "Envelope"
            ]
          }
        ],
