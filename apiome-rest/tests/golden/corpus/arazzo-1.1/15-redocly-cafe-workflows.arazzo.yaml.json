      {
        "description": "Wait for a specific customer's signup event from the account service.",
        "extras": {
          "inputs": {
            "properties": {
              "email": {
                "type": "string"
              }
            },
            "required": [
              "email"
            ],
            "type": "object"
          },
          "outputs": {
            "newCustomerEmail": "$steps.await-signup.outputs.email"
          },
          "stepOrder": [
            "await-signup"
          ],
          "summary": "Wait for a specific customer's signup event from the account service.",
          "workflowId": "await-customer-signup",
          "workflowIndex": 2
        },
        "key": "await-customer-signup",
        "name": "await-customer-signup",
        "operations": [
          {
            "channel_ref": null,
            "deprecated": false,
            "description": "Receive the signup event that matches the expected email.",
            "extras": {
              "action": "receive",
              "asyncStep": true,
              "channelPath": "$sourceDescriptions.account-events#/channels/customerSignedUp",
              "correlationId": "$inputs.email",
              "outputs": {
                "customerName": {
                  "context": "$message.payload",
                  "selector": "$.customerName",
                  "type": "jsonpath"
                },
                "email": {
                  "context": "$message.payload",
                  "selector": "/email",
                  "type": {
                    "type": "jsonpointer",
                    "version": "rfc6901"
                  }
                }
              },
              "sourceDescription": "account-events",
              "sourceType": "asyncapi",
              "stepId": "await-signup",
              "stepIndex": 0,
              "successCriteria": [
                {
                  "condition": "$.email",
                  "context": "$message.payload",
                  "type": {
                    "type": "jsonpath",
                    "version": "rfc9535"
                  }
                }
              ],
              "timeout": 10000
            },
            "http_method": null,
            "http_path": null,
            "key": "await-customer-signup#await-signup",
