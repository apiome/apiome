            ]
          }
        ]
      },
      {
        "description": "Order the first available beverage and confirm it was placed.",
        "extras": {
          "inputs": {
            "properties": {
              "customerName": {
                "type": "string"
              }
            },
            "required": [
              "customerName"
            ],
            "type": "object"
          },
          "outputs": {
            "placedOrderId": "$steps.create-order.outputs.orderId"
          },
          "stepOrder": [
            "find-beverage",
            "create-order",
            "confirm-order"
          ],
          "summary": "Order the first available beverage and confirm it was placed.",
          "workflowId": "place-order",
          "workflowIndex": 0
        },
        "key": "place-order",
        "name": "place-order",
        "operations": [
          {
            "channel_ref": null,
            "deprecated": false,
            "description": "Fetch the order and confirm it was placed.",
            "extras": {
              "dependsOn": [
                "create-order"
              ],
              "onFailure": [
                {
                  "name": "retry-confirmation",
                  "parameters": [
                    {
                      "name": "orderId",
                      "value": "$steps.create-order.outputs.orderId"
                    }
                  ],
                  "retryAfter": 2,
                  "retryLimit": 3,
                  "type": "retry",
                  "workflowId": "notify-customer"
                }
              ],
              "onSuccess": [
                {
                  "name": "notify-customer",
                  "parameters": [
                    {
                      "name": "orderId",
                      "value": "$steps.create-order.outputs.orderId"
                    }
                  ],
                  "type": "goto",
                  "workflowId": "notify-customer"
                }
              ],
              "operationId": "cafe-api.getOrderById",
              "parameters": [
                {
                  "in": "path",
                  "name": "orderId",
                  "value": "$steps.create-order.outputs.orderId"
                }
              ],
              "stepId": "confirm-order",
              "stepIndex": 2,
              "successCriteria": [
                {
                  "condition": "$statusCode == 200"
                },
                {
                  "condition": "$[?(@.status == 'placed')]",
                  "context": "$response.body",
                  "type": {
                    "type": "jsonpath",
                    "version": "rfc9535"
                  }
                }
              ],
              "timeout": 5000
            },
            "http_method": null,
            "http_path": null,
            "key": "place-order#confirm-order",
            "kind": "one_way",
            "messages": [],
            "name": "confirm-order",
            "parameters": [],
            "streaming": "none",
            "tags": [
              "place-order"
            ]
          },
          {
            "channel_ref": null,
            "deprecated": false,
            "description": "Place an order for the selected beverage.",
            "extras": {
              "dependsOn": [
                "find-beverage"
              ],
              "operationId": "cafe-api.createOrder",
              "outputs": {
                "orderId": "$response.body#/id"
              },
              "requestBody": {
                "contentType": "application/json",
                "payload": {
                  "customerName": "",
                  "orderItems": [
                    {
                      "menuItemId": "",
                      "quantity": 1
                    }
                  ]
                },
                "replacements": [
                  {
                    "target": "/orderItems/0/menuItemId",
                    "targetSelectorType": "jsonpointer",
                    "value": "$steps.find-beverage.outputs.beverageId"
                  },
                  {
                    "target": "$.customerName",
                    "targetSelectorType": {
                      "type": "jsonpath",
                      "version": "rfc9535"
                    },
                    "value": {
                      "context": "$inputs",
                      "selector": "$.customerName",
                      "type": "jsonpath"
                    }
                  }
                ]
              },
              "stepId": "create-order",
              "stepIndex": 1,
              "successCriteria": [
                {
                  "condition": "$statusCode == 201"
                }
              ]
            },
            "http_method": null,
            "http_path": null,
            "key": "place-order#create-order",
            "kind": "one_way",
            "messages": [],
            "name": "create-order",
            "parameters": [],
            "streaming": "none",
            "tags": [
              "place-order"
            ]
          },
          {
            "channel_ref": null,
            "deprecated": false,
            "description": "List the beverages on the menu and capture the first item.",
            "extras": {
              "operationId": "cafe-api.listMenuItems",
              "outputs": {
                "beverageId": {
                  "context": "$response.body",
                  "selector": "$.items[0].id",
                  "type": "jsonpath"
                }
              },
              "parameters": [
                {
                  "in": "querystring",
                  "name": "query",
                  "value": "filter=category:beverage&limit=5"
                }
              ],
              "stepId": "find-beverage",
              "stepIndex": 0,
              "successCriteria": [
                {
                  "condition": "$statusCode == 200"
                },
                {
                  "condition": "$.items[?(@.category == 'beverage')]",
                  "context": "$response.body",
                  "type": {
                    "type": "jsonpath",
                    "version": "rfc9535"
                  }
                }
              ]
            },
            "http_method": null,
            "http_path": null,
            "key": "place-order#find-beverage",
            "kind": "one_way",
            "messages": [],
            "name": "find-beverage",
            "parameters": [],
            "streaming": "none",
            "tags": [
              "place-order"
