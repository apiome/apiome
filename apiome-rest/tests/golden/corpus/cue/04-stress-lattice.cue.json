    "description": null,
    "extras": {
      "cue": {
        "capability_limits": [
          {
            "construct": "cue.additional_properties",
            "count": 1,
            "detail": "A CUE record that declares fields and also accepts any other key describes the extra keys it may carry. The canonical record has no additional-properties slot, so it is recorded in `typescript_index` on the record; a record that is nothing but its extra keys is modelled as a map.",
            "locations": [
              "Open"
            ]
          },
          {
            "construct": "cue.builtin_validator",
            "count": 1,
            "detail": "A validator from CUE's standard library other than the rune and item-count bounds (`strings.HasPrefix`, `net.IPv4`, `time.Time`, …) has no JSON Schema keyword. The field's type is modelled; the validator is not.",
            "locations": [
              "Computed.upper"
            ]
          },
          {
            "construct": "cue.bytes",
            "count": 1,
            "detail": "A `bytes` value has no JSON Schema type. The field is modelled as accepting any value.",
            "locations": [
              "Scalars.blob"
            ]
          },
          {
            "construct": "cue.comprehension",
            "count": 1,
            "detail": "A comprehension (`[for x in xs {…}]`) computes a value from other values during evaluation. JSON Schema cannot say how a field is computed, so the field is left out of the model.",
            "locations": [
              "Computed.upper"
            ]
          },
          {
            "construct": "cue.conditional_field",
            "count": 2,
            "detail": "A conditional field (`if tier == \"paid\" { seats: … }`) exists only when another field has a given value. The definition's unconditional fields are modelled; the conditional ones, and the condition, are not. A definition that is nothing but its conditions is left out.",
            "locations": [
              "Conditional"
            ]
          },
          {
            "construct": "cue.default",
            "count": 3,
            "detail": "A default (`*\"new\"`) is applied by CUE's evaluation; the JSON Schema CUE generates does not carry it, so the field is modelled with its type and without the default.",
            "locations": [
              "WithDefaults.label",
              "WithDefaults.mode",
              "WithDefaults.retries"
            ]
          },
          {
            "construct": "cue.hidden_field",
            "count": 1,
            "detail": "A hidden field (`_secret`) and a hidden definition are private to the CUE package and are never exported. They are not modelled.",
            "locations": [
              "Hidden._secret"
            ]
          },
          {
            "construct": "cue.interpolation",
            "count": 1,
            "detail": "An interpolated string (`\"\\(host):\\(port)\"`) is computed from other fields. The field is left out of the model rather than typed as any string.",
            "locations": [
              "Interpolated.target"
            ]
          },
          {
            "construct": "cue.let_binding",
            "count": 1,
            "detail": "A `let` binding is a name that exists only during evaluation. Constraints written in terms of it keep the bound value CUE resolved; the binding itself is not modelled.",
            "locations": [
              "Hidden"
            ]
          },
          {
            "construct": "cue.tuple_positions",
            "count": 2,
            "detail": "A fixed-length list (a tuple) becomes a list whose items are the union of its element types, bounded by its length. Which type sits at which position is recorded in `typescript_tuple` — preserved and reportable, but not enforced by the canonical list.",
            "locations": [
              "Collections.fixed",
              "Collections.nonEmpty"
            ]
          }
        ],
