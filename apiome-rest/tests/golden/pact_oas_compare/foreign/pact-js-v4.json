              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.lines[*].quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                },
