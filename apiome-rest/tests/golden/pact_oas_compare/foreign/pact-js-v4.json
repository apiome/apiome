              "id": 7,
              "name": "Acme Corp"
            },
            "id": 1042,
            "lines": [
              {
                "quantity": 2,
                "sku": "SKU-1"
              },
              {
                "quantity": 2,
                "sku": "SKU-1"
              }
            ],
            "number": "INV-1042",
            "paid": false,
            "status": "open"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.customer.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.customer.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
