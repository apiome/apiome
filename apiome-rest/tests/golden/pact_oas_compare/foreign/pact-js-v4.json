                {
                  "match": "type"
                },
                {
                  "match": "type"
                }
              ]
            },
            "$.number": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^INV-\\d{4}$"
                }
              ]
            },
            "$.paid": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
