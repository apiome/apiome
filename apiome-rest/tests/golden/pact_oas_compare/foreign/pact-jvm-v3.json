{
  "consumer": {
    "name": "billing-batch-jvm"
  },
  "interactions": [
    {
      "description": "a request to create an invoice",
      "request": {
        "body": {
          "currency": "USD",
          "customerId": 7,
          "lines": [
            {
              "quantity": 2,
              "sku": "SKU-1"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.customerId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines[*].quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.lines[*].sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/invoices"
      },
      "response": {
        "body": {
          "id": 1043,
          "status": "draft"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "a request for invoice 1042",
      "providerStates": [
        {
          "name": "invoice 1042 exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/invoices/1042"
      },
      "response": {
        "body": {
          "currency": "USD",
          "customer": {
            "id": 7,
            "name": "Acme Corp"
          },
          "id": 1042,
          "issuedAt": "2000-01-31T06:00:00-07:00",
          "lines": [
            {
              "quantity": 2,
              "sku": "SKU-1"
            }
          ],
          "number": "INV-1042",
          "paid": false,
          "status": "open",
          "total": 129.5
        },
        "generators": {
          "body": {
            "$.issuedAt": {
              "format": "yyyy-MM-dd'T'HH:mm:ssXXX",
              "type": "DateTime"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.customer.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.customer.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.issuedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ssXXX",
                  "match": "timestamp"
                }
              ]
            },
            "$.lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.lines[*].quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.lines[*].sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.number": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^INV-\\d{4}$"
                }
              ]
            },
            "$.paid": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a search for open invoices",
      "providerStates": [
        {
          "name": "open invoices exist"
        }
      ],
      "request": {
        "matchingRules": {
          "query": {
            "limit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "\\d+"
                }
              ]
            },
            "status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "open|paid|draft"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/invoices",
        "query": {
          "limit": [
            "25"
          ],
          "status": [
            "open"
          ]
        }
      },
      "response": {
        "body": {
          "items": [
            {
              "id": 1042,
              "status": "open"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.items[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.17"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "ledger-api"
  }
}
