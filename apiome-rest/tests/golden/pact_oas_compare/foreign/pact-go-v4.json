{
  "consumer": {
    "name": "billing-worker-go"
  },
  "interactions": [
    {
      "description": "a request for invoice 1042",
      "pending": false,
      "providerStates": [
        {
          "name": "invoice 1042 exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": [
            "application/json"
          ]
        },
        "method": "GET",
        "path": "/invoices/1042"
      },
      "response": {
        "body": {
          "content": {
            "currency": "USD",
            "id": 1042,
            "lines": [
              {
                "quantity": 2,
                "sku": "SKU-1"
              }
            ],
            "number": "INV-1042",
            "status": "open",
            "total": 129.5
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.lines[*].quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.lines[*].sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.number": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^INV-\\d{4}$"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to record a payment",
      "pending": false,
      "providerStates": [
        {
          "name": "invoice 1042 is open"
        }
      ],
      "request": {
        "body": {
          "content": {
            "amount": 129.5,
            "metadata": {
              "source": "worker"
            },
            "method": "card"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.metadata.source": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.method": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(card|transfer)$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/invoices/1042/payments"
      },
      "response": {
        "body": {
          "content": {
            "id": 88,
            "status": "settled"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-go": {
      "version": "dev"
    },
    "pactRust": {
      "ffi": "0.5.12",
      "mockserver": "2.2.6",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "ledger-api"
  }
}