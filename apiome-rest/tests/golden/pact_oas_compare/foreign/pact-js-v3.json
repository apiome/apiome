{
  "consumer": {
    "name": "billing-web-js"
  },
  "interactions": [
    {
      "description": "a request for a missing invoice",
      "providerStates": [
        {
          "name": "invoice 9999 does not exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/invoices/9999"
      },
      "response": {
        "body": {
          "code": "not_found",
          "message": "Invoice 9999 was not found"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "a request for invoice 1042",
      "providerStates": [
        {
          "name": "invoice 1042 exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "matchingRules": {
          "path": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "/invoices/\\d+"
              }
            ]
          }
        },
        "method": "GET",
        "path": "/invoices/1042"
      },
      "response": {
        "body": {
          "currency": "USD",
          "customer": {
            "id": 7,
            "name": "Acme Corp"
          },
          "id": 1042,
          "issuedAt": "2026-11-01T09:30:00+00:00",
          "lines": [
            {
              "quantity": 2,
              "sku": "SKU-1",
              "unitPrice": 64.75
            }
          ],
          "number": "INV-1042",
          "status": "open",
          "total": 129.5
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.customer": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.issuedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ssXXX",
                  "match": "datetime"
                }
              ]
            },
            "$.lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.lines[*].quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.lines[*].sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines[*].unitPrice": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.number": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^INV-\\d{4}$"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to create an invoice",
      "request": {
        "body": {
          "currency": "USD",
          "customerId": 7,
          "lines": [
            {
              "quantity": 2,
              "sku": "SKU-1"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json",
          "Idempotency-Key": "6f1c2d0e-9a4b-4c8d-8e2f-3a5b7c9d1e0f"
        },
        "matchingRules": {
          "body": {
            "$.customerId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "Idempotency-Key": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/invoices"
      },
      "response": {
        "body": {
          "id": 1043,
          "status": "draft"
        },
        "headers": {
          "Content-Type": "application/json",
          "Location": "/invoices/1043"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "Location": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^/invoices/\\d+$"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "a search for open invoices",
      "providerStates": [
        {
          "name": "open invoices exist"
        }
      ],
      "request": {
        "matchingRules": {
          "query": {
            "limit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "\\d+"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/invoices",
        "query": {
          "limit": [
            "25"
          ],
          "status": [
            "open"
          ]
        }
      },
      "response": {
        "body": {
          "items": [
            {
              "id": 1042,
              "status": "open"
            }
          ],
          "nextCursor": null
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.items[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.nextCursor": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "null"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "ledger-api"
  }
}