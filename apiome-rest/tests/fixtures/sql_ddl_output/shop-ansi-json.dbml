// Shop: DBML (ansi), generated by Apiome.
Enum status {
  "open"
  "shipped"
}

Table order {
  order_id CHAR(36) [not null]
  user VARCHAR(40) [not null]
  status status [not null, default: 'open']
  total "DECIMAL(38, 2)" [not null, check: `total >= 0`]
  weight "DOUBLE PRECISION" [check: `weight < 500`]
  code CLOB [check: `CHARACTER_LENGTH(code) >= 3`]
  placed_at "TIMESTAMP WITH TIME ZONE" [not null]
  ship_to JSON
  lines JSON [not null]
  tags JSON
  payment JSON
}

Table order_line {
  sku VARCHAR(16) [not null]
  qty INTEGER [not null, check: `qty >= 1`]
}

Table address {
  id BIGINT [not null]
  city CLOB
}
