// Shop: DBML (mysql), generated by Apiome.
Project Shop {
  database_type: 'MySQL'
}

Enum status {
  "open"
  "shipped"
}

Table order_lines {
  order_id BIGINT [not null]
  order_line_id BIGINT [not null]
  position INTEGER [not null]

  indexes {
    (order_id, position) [pk]
  }
}

Table order_tags {
  order_id BIGINT [not null]
  position INTEGER [not null]
  value TEXT

  indexes {
    (order_id, position) [pk]
  }
}

Table order {
  id BIGINT [pk, increment]
  order_id CHAR(36) [not null]
  user VARCHAR(40) [not null]
  status status [not null, default: 'open']
  total "DECIMAL(38, 2)" [not null, check: `total >= 0`]
  weight DOUBLE [check: `weight < 500`]
  code TEXT [check: `CHAR_LENGTH(code) >= 3`, check: `REGEXP_LIKE(code, '^[A-Z]{3}$')`]
  placed_at DATETIME(6) [not null]
  ship_to_id BIGINT
  payment JSON
}

Table order_line {
  id BIGINT [pk, increment]
  sku VARCHAR(16) [not null]
  qty INT [not null, check: `qty >= 1`]
}

Table address {
  id BIGINT [pk]
  city TEXT
}

Ref fk_order_lines_1: order_lines.order_id > order.id
Ref fk_order_lines_2: order_lines.order_line_id > order_line.id
Ref fk_order_tags_1: order_tags.order_id > order.id
Ref fk_order_1: order.ship_to_id > address.id
