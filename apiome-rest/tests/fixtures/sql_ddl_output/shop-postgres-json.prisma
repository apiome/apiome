// Shop: Prisma schema (postgres), generated by Apiome.
datasource db {
  provider = "postgresql"
}

enum Status {
  open
  shipped

  @@map("status")
}

model Order {
  id BigInt @id @default(autoincrement())
  order_id String @db.Uuid
  user String @db.VarChar(40)
  status Status @default(open)
  total Decimal @db.Decimal(38, 2)
  weight Float?
  code String?
  placed_at DateTime @db.Timestamptz
  ship_to Json?
  lines Json
  tags String[]
  payment Json?

  @@map("order")
}

model OrderLine {
  id BigInt @id @default(autoincrement())
  sku String @db.VarChar(16)
  qty Int

  @@map("order_line")
}

model Address {
  id BigInt @id
  city String?

  @@map("address")
}
