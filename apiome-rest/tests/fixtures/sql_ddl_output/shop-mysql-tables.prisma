// Shop: Prisma schema (mysql), generated by Apiome.
datasource db {
  provider = "mysql"
}

enum Status {
  open
  shipped
}

model OrderLines {
  order_id BigInt
  order_line_id BigInt
  position Int
  order Order @relation("fk_order_lines_1", fields: [order_id], references: [id])
  order_line OrderLine @relation("fk_order_lines_2", fields: [order_line_id], references: [id])

  @@id([order_id, position])
  @@map("order_lines")
}

model OrderTags {
  order_id BigInt
  position Int
  value String? @db.Text
  order Order @relation("fk_order_tags_1", fields: [order_id], references: [id])

  @@id([order_id, position])
  @@map("order_tags")
}

model Order {
  id BigInt @id @default(autoincrement())
  order_id String @db.Char(36)
  user String @db.VarChar(40)
  status Status @default(open)
  total Decimal @db.Decimal(38, 2)
  weight Float?
  code String? @db.Text
  placed_at DateTime @db.DateTime(6)
  ship_to_id BigInt?
  payment Json?
  ship_to Address? @relation("fk_order_1", fields: [ship_to_id], references: [id])
  order_lines OrderLines[] @relation("fk_order_lines_1")
  order_tags OrderTags[] @relation("fk_order_tags_1")

  @@map("order")
}

model OrderLine {
  id BigInt @id @default(autoincrement())
  sku String @db.VarChar(16)
  qty Int
  order_lines OrderLines[] @relation("fk_order_lines_2")

  @@map("order_line")
}

model Address {
  id BigInt @id
  city String? @db.Text
  order Order[] @relation("fk_order_1")

  @@map("address")
}
