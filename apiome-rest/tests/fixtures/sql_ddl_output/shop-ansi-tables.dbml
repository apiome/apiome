// Shop: DBML (ansi), generated by Apiome.
Enum status {
  "open"
  "shipped"
}

Table order_lines {
  order_id BIGINT [not null]
  order_line_id BIGINT [not null]
  position INTEGER [not null]

  indexes {
    (order_id, position) [pk]
  }
}

Table order_tags {
  order_id BIGINT [not null]
  position INTEGER [not null]
  value CLOB

  indexes {
    (order_id, position) [pk]
  }
}

Table order {
  id BIGINT [pk, increment]
  order_id CHAR(36) [not null]
  user VARCHAR(40) [not null]
  status status [not null, default: 'open']
  total "DECIMAL(38, 2)" [not null, check: `total >= 0`]
  weight "DOUBLE PRECISION" [check: `weight < 500`]
  code CLOB [check: `CHARACTER_LENGTH(code) >= 3`]
  placed_at "TIMESTAMP WITH TIME ZONE" [not null]
  ship_to_id BIGINT
  payment JSON
}

Table order_line {
  id BIGINT [pk, increment]
  sku VARCHAR(16) [not null]
  qty INTEGER [not null, check: `qty >= 1`]
}

Table address {
  id BIGINT [pk]
  city CLOB
}

Ref fk_order_lines_1: order_lines.order_id > order.id
Ref fk_order_lines_2: order_lines.order_line_id > order_line.id
Ref fk_order_tags_1: order_tags.order_id > order.id
Ref fk_order_1: order.ship_to_id > address.id
