// Shop: DBML (postgres), generated by Apiome.
Project Shop {
  database_type: 'PostgreSQL'
}

Enum status {
  "open"
  "shipped"
}

Table order {
  order_id UUID [not null]
  user VARCHAR(40) [not null]
  status status [not null, default: 'open']
  total "NUMERIC(38, 2)" [not null, check: `total >= 0`]
  weight "DOUBLE PRECISION" [check: `weight < 500`]
  code TEXT [check: `CHAR_LENGTH(code) >= 3`, check: `code ~ '^[A-Z]{3}$'`]
  placed_at TIMESTAMPTZ [not null]
  ship_to JSONB
  lines JSONB [not null]
  tags "TEXT[]"
  payment JSONB
}

Table order_line {
  sku VARCHAR(16) [not null]
  qty INTEGER [not null, check: `qty >= 1`]
}

Table address {
  id BIGINT [not null]
  city TEXT
}
