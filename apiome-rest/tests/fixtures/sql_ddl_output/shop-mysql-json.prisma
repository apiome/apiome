// Shop: Prisma schema (mysql), generated by Apiome.
datasource db {
  provider = "mysql"
}

enum Status {
  open
  shipped
}

model Order {
  id BigInt @id @default(autoincrement())
  order_id String @db.Char(36)
  user String @db.VarChar(40)
  status Status @default(open)
  total Decimal @db.Decimal(38, 2)
  weight Float?
  code String? @db.Text
  placed_at DateTime @db.DateTime(6)
  ship_to Json?
  lines Json
  tags Json?
  payment Json?

  @@map("order")
}

model OrderLine {
  id BigInt @id @default(autoincrement())
  sku String @db.VarChar(16)
  qty Int

  @@map("order_line")
}

model Address {
  id BigInt @id
  city String? @db.Text

  @@map("address")
}
