// Shop: DBML (mysql), generated by Apiome.
Project Shop {
  database_type: 'MySQL'
}

Enum status {
  "open"
  "shipped"
}

Table order {
  order_id CHAR(36) [not null]
  user VARCHAR(40) [not null]
  status status [not null, default: 'open']
  total "DECIMAL(38, 2)" [not null, check: `total >= 0`]
  weight DOUBLE [check: `weight < 500`]
  code TEXT [check: `CHAR_LENGTH(code) >= 3`, check: `REGEXP_LIKE(code, '^[A-Z]{3}$')`]
  placed_at DATETIME(6) [not null]
  ship_to JSON
  lines JSON [not null]
  tags JSON
  payment JSON
}

Table order_line {
  sku VARCHAR(16) [not null]
  qty INT [not null, check: `qty >= 1`]
}

Table address {
  id BIGINT [not null]
  city TEXT
}
