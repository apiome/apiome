{
  "openapi": "3.1.0",
  "info": {"title": "Inventory", "version": "1.0.0"},
  "paths": {
    "/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "description": "ok",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Product"}}}
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Product"}}}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "unitsInStock": {"type": "integer"},
          "warehouse": {"$ref": "#/components/schemas/Warehouse"}
        }
      },
      "Warehouse": {
        "type": "object",
        "properties": {
          "city": {"type": "string"},
          "dock": {"type": "string"}
        }
      }
    }
  }
}
