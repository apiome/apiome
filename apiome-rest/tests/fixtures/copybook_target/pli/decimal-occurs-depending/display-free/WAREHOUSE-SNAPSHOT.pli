 /* Generated PL/I include structure for WAREHOUSE-SNAPSHOT */
 DCL 1 WAREHOUSE_SNAPSHOT UNALIGNED BASED,
   2 WH_ID CHAR(4),
   2 WH_REGION_CODE FIXED BIN(15),
   2 WH_CAPACITY_UNITS FIXED BIN(31),
   2 WH_UTILIZATION_PCT FIXED DEC(5,2),
   2 * CHAR(5),
   2 WH_BIN_COUNT PIC'(3)9',
   2 WH_BINS(10 REFER(WH_BIN_COUNT)),
     3 BIN_ID CHAR(6),
     /* values: BIN_ACTIVE = 'A', BIN_UNUSABLE = 'B' 'X' */
     3 BIN_STATUS CHAR(1),
     3 BIN_MEASURES,
       4 BIN_WEIGHT_KG FIXED DEC(8,3),
       4 BIN_VOLUME_M3 FIXED DEC(6,3),
     3 BIN_LAST_COUNTED PIC'(8)9',
   2 WH_AUDIT,
     3 WH_AUDIT_USER CHAR(8),
     3 WH_AUDIT_TS PIC'(14)9';
