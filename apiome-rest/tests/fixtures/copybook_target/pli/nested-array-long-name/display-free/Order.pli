 /* Generated PL/I include structure for Order */
 DCL 1 ORDER_X UNALIGNED BASED,
   2 CUSTOMER_LOYALTY_PROGRAM_MEMBE CHAR(20),
   2 DISCOUNT_RATE PIC'(16)9V9T',
   2 LINES_X_COUNT PIC'(3)9T',
   2 LINES_X(50 REFER(LINES_X_COUNT)),
     /* format: int32 */
     3 QUANTITY PIC'(18)9',
     3 SKU CHAR(16),
     3 UNIT_PRICE PIC'(16)9V9T',
     3 WAREHOUSE_BIN_LOCATION_REFEREN CHAR(8),
   2 NOTES_COUNT PIC'(3)9T',
   2 NOTES(10 REFER(NOTES_COUNT)) CHAR(255),
   2 ORDER_ID CHAR(12),
   2 SHIP_TO,
     3 CITY CHAR(30),
     3 GEO,
       4 LATITUDE PIC'(12)9V(5)9T',
       4 LONGITUDE PIC'(12)9V(5)9T',
     3 POSTAL_CODE CHAR(10),
     3 STREET CHAR(40),
   2 TOTAL PIC'(16)9V9T';
