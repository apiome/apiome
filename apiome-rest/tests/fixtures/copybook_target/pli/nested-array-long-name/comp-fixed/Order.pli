 /* Generated PL/I include structure for Order */
 DCL 1 ORDER_X UNALIGNED BASED,
   2 CUSTOMER_LOYALTY_PROGRAM_MEMBE CHAR(20),
   2 DISCOUNT_RATE FLOAT DEC(16),
   2 LINES_X_COUNT FIXED BIN(15),
   2 LINES_X(50 REFER(LINES_X_COUNT)),
     /* format: int32 */
     3 QUANTITY FIXED BIN(63),
     3 SKU CHAR(16),
     3 UNIT_PRICE FLOAT DEC(16),
     3 WAREHOUSE_BIN_LOCATION_REFEREN CHAR(8),
   2 NOTES_COUNT FIXED BIN(15),
   2 NOTES(10 REFER(NOTES_COUNT)) CHAR(255),
   2 ORDER_ID CHAR(12),
   2 SHIP_TO,
     3 CITY CHAR(30),
     3 GEO,
       4 LATITUDE FLOAT DEC(16),
       4 LONGITUDE FLOAT DEC(16),
     3 POSTAL_CODE CHAR(10),
     3 STREET CHAR(40),
   2 TOTAL FLOAT DEC(16);
