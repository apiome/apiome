 /* Generated PL/I include structure for PAYMENT-RECORD */
 DCL 1 PAYMENT_RECORD UNALIGNED,
   2 PAYMENT_ID PIC'(10)9',
   /* values: PAY_BY_CARD = 'C', PAY_BY_BANK = 'B' */
   2 PAYMENT_TYPE CHAR(1),
   2 PAYMENT_AMOUNT FIXED DEC(11,2),
   2 PAYMENT_DETAIL_UNION UNION,
     3 PAYMENT_DETAIL CHAR(30),
     3 CARD_DETAIL,
       4 CARD_NUMBER PIC'(16)9',
       4 CARD_EXPIRY_YYMM PIC'(4)9',
       4 * CHAR(10),
     3 BANK_DETAIL,
       4 BANK_ROUTING PIC'(9)9',
       4 BANK_ACCOUNT CHAR(17),
       4 * CHAR(4),
   2 PAYMENT_POSTED_DATE PIC'(8)9';
