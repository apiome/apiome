    "asn1-choice": [
      "Priority ::= ENUMERATED { low(0), normal(1), high(2), critical(3) }",
      "Endpoint ::= SET {",
      "host [0] EXPLICIT IA5String,",
      "port [1] EXPLICIT INTEGER (1..65535),",
      "tag [2] EXPLICIT PrintableString OPTIONAL",
      "}",
      "Envelope ::= SEQUENCE {",
      "version [0] EXPLICIT INTEGER DEFAULT 1,",
      "priority [1] EXPLICIT Priority DEFAULT normal,",
      "transport [2] EXPLICIT EnvelopeTransport DEFAULT tcp,",
      "contentType [3] EXPLICIT OBJECT IDENTIFIER,",
      "flags [4] EXPLICIT BIT STRING OPTIONAL,",
      "source [5] EXPLICIT Endpoint,",
      "hops [6] EXPLICIT SEQUENCE OF Endpoint,",
      "payload [7] EXPLICIT Payload,",
      "ttlSeconds [8] EXPLICIT INTEGER (0..86400) DEFAULT 3600",
      "}",
      "EnvelopeTransport ::= ENUMERATED { tcp(0), udp(1), quic(2) }",
      "Payload ::= CHOICE {",
      "text [0] EXPLICIT UTF8String,",
      "binary [1] EXPLICIT OCTET STRING (SIZE (1..4096)),",
      "empty [2] EXPLICIT NULL",
      "}"
    ],
    "constrained": [
      "Address ::= CHOICE {",
      "ipv4 Ipv4,",
      "hostName HostName",
      "}",
      "Device ::= SEQUENCE {",
      "address Address OPTIONAL,",
      "model UTF8String (SIZE (1..MAX)) (FROM (\"A\"..\"Z\")),",
      "port INTEGER (1..65535),",
      "ratio REAL (0..1) OPTIONAL,",
      "serial UTF8String (SIZE (8..16)),",
      "tags SEQUENCE (SIZE (1..4)) OF UTF8String OPTIONAL",
      "}",
      "HostName ::= SEQUENCE {",
      "name UTF8String (SIZE (0..253)) OPTIONAL",
      "}",
      "Ipv4 ::= SEQUENCE {",
      "octets UTF8String (SIZE (0..15)) OPTIONAL",
      "}"
    ]
  },
