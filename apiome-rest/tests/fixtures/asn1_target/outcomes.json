    "constrained": [
      "Address ::= CHOICE {",
      "ipv4 Ipv4,",
      "hostName HostName",
      "}",
      "Device ::= SEQUENCE {",
      "address Address OPTIONAL,",
      "model UTF8String (SIZE (1..MAX)) (FROM (\"A\"..\"Z\")),",
      "port INTEGER (1..65535),",
      "ratio REAL (0..1) OPTIONAL,",
      "serial UTF8String (SIZE (8..16)),",
      "tags SEQUENCE (SIZE (1..4)) OF UTF8String OPTIONAL",
      "}",
      "HostName ::= SEQUENCE {",
      "name UTF8String (SIZE (0..253)) OPTIONAL",
      "}",
      "Ipv4 ::= SEQUENCE {",
