      "Priority ::= ENUMERATED { low(0), normal(1), high(2), critical(3) }",
      "Endpoint ::= SEQUENCE {",
      "host UTF8String,",
      "port INTEGER,",
      "tag UTF8String OPTIONAL",
      "}",
      "Envelope ::= SEQUENCE {",
      "version INTEGER,",
      "priority Priority DEFAULT normal,",
      "transport EnvelopeTransport DEFAULT tcp,",
      "contentType OBJECT IDENTIFIER,",
      "flags OCTET STRING OPTIONAL,",
      "source Endpoint,",
      "hops SEQUENCE OF Endpoint,",
      "payload Payload,",
      "ttlSeconds INTEGER",
      "}",
      "EnvelopeTransport ::= ENUMERATED { tcp(0), udp(1), quic(2) }",
      "Payload ::= CHOICE {",
      "text UTF8String,",
      "binary OCTET STRING,",
      "empty NULL",
      "}"
