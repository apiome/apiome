{
  "kind": "fix",
  "id": "fix/arazzo.success-criteria-scaffold",
  "rule": "arazzo.success-criteria-scaffold",
  "options": {
    "optIn": [
      "arazzo.success-criteria-scaffold"
    ]
  },
  "finding": {
    "path": "workflows.0.steps.0",
    "message": "Step declares no successCriteria; its operation declares a 200 response."
  },
  "before": {
    "arazzo": "1.0.1",
    "info": {
      "title": "Pet flows",
      "version": "1.0.0"
    },
    "sourceDescriptions": [
      {
        "name": "pets",
        "type": "openapi",
        "url": "./pets.yaml",
        "content": {
          "openapi": "3.1.0",
          "info": {
            "title": "Pets",
            "version": "1.0.0"
          },
          "paths": {
            "/pets": {
              "get": {
                "operationId": "listPets",
                "responses": {
                  "200": {
                    "description": "ok"
                  }
                }
              }
            }
          }
        }
      }
    ],
    "workflows": [
      {
        "workflowId": "browse",
        "steps": [
          {
            "stepId": "list",
            "operationId": "$sourceDescriptions.pets.listPets"
          }
        ]
      }
    ]
  },
  "plan": [
    {
      "op": "add",
      "path": "/workflows/0/steps/0/successCriteria",
      "value": [
        {
          "condition": "$statusCode == 200"
        }
      ]
    }
  ],
  "classification": {
    "maxSeverity": null,
    "planStatus": "ready"
  },
  "after": {
    "arazzo": "1.0.1",
    "info": {
      "title": "Pet flows",
      "version": "1.0.0"
    },
    "sourceDescriptions": [
      {
        "name": "pets",
        "type": "openapi",
        "url": "./pets.yaml",
        "content": {
          "openapi": "3.1.0",
          "info": {
            "title": "Pets",
            "version": "1.0.0"
          },
          "paths": {
            "/pets": {
              "get": {
                "operationId": "listPets",
                "responses": {
                  "200": {
                    "description": "ok"
                  }
                }
              }
            }
          }
        }
      }
    ],
    "workflows": [
      {
        "workflowId": "browse",
        "steps": [
          {
            "stepId": "list",
            "operationId": "$sourceDescriptions.pets.listPets",
            "successCriteria": [
              {
                "condition": "$statusCode == 200"
              }
            ]
          }
        ]
      }
    ]
  }
}
