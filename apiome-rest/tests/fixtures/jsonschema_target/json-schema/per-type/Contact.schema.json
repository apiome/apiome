{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contact",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "$ref": "PersonName.schema.json"
    },
    "address": {
      "$ref": "Address.schema.json"
    },
    "phones": {
      "type": "array",
      "items": {
        "$ref": "PhoneNumber.schema.json"
      }
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name"
  ],
  "description": "A contact in the address book"
}
