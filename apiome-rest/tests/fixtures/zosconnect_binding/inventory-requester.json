{
  "apiRequester": {
    "name": "InventoryRequester",
    "version": "1.0.0",
    "description": "Outbound API requester invoked from the CICS program INVPGM."
  },
  "api": {
    "title": "Inventory API",
    "specification": "openapi-3.0",
    "basePath": "https://api.example.com/inventory"
  },
  "language": {"type": "cobol", "codepage": "IBM-1047"},
  "operations": [
    {
      "operationId": "getStockLevel",
      "method": "GET",
      "path": "/items/{sku}/stock",
      "requestStructure": "GET-STOCK-REQUEST",
      "responseStructure": "GET-STOCK-RESPONSE",
      "program": "INVPGM",
      "pathParameters": [{"name": "sku", "field": "REQ-SKU", "type": "string"}]
    },
    {
      "operationId": "reserveStock",
      "method": "POST",
      "path": "/items/{sku}/reservations",
      "requestStructure": "RESERVE-REQUEST",
      "responseStructure": "RESERVE-RESPONSE",
      "program": "INVPGM",
      "pathParameters": [{"name": "sku", "field": "RES-SKU", "type": "string"}]
    }
  ]
}
