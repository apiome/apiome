{
  "components": {
    "schemas": {
      "Error": {
        "properties": {
          "code": {
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "Pet": {
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "tag": {
            "description": "A free-form tag.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Pets.",
    "title": "Pet Store",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/pets": {
      "get": {
        "operationId": "PetService_listPets",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Trace",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Pet"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The request has succeeded."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "An unexpected error response."
          }
        }
      },
      "post": {
        "operationId": "PetService_createPet",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pet"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            },
            "description": "The request has succeeded and a new resource has been created as a result.",
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{pet-id}": {
      "get": {
        "operationId": "PetService_showPetById",
        "parameters": [
          {
            "in": "path",
            "name": "pet-id",
            "required": true,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            },
            "description": "The request has succeeded."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The server cannot find the requested resource."
          },
          "5XX": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://{region}.example.com/v1",
      "variables": {
        "region": {
          "default": "eu"
        }
      }
    }
  ],
  "tags": []
}