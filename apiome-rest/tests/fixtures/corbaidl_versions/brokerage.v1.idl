// CORBA IDL version fixture (MFI-21.4, #3994): a brokerage interface set, v1.
//
// Exercises what the CORBA diff grades: interface inheritance (`Account : Auditable`), an
// attribute and a readonly attribute, a oneway operation, positional in/out/inout parameters,
// raises clauses, a bounded string, a struct, an exception and an enum.
module Brokerage {
  typedef string<12> Symbol;

  enum Side { BUY, SELL };

  struct Order {
    Symbol symbol;
    Side side;
    long quantity;
    double limitPrice;
  };

  exception Rejected {
    string reason;
  };

  interface Auditable {
    readonly attribute string auditId;
    void audit(in string note);
  };

  interface Account : Auditable {
    attribute string nickname;
    string place(in Order order, inout double price) raises (Rejected);
    void cancel(in string orderId);
    oneway void heartbeat(in long seq);
  };
};
