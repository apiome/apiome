{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@apiome/cli#build": {
      "outputs": []
    },
    "apiome-mcp#build": {
      "outputs": []
    },
    "apiome-mock#build": {
      "outputs": []
    },
    "apiome-docs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.docusaurus/**",
        "!build/**",
        "$TURBO_ROOT$/apiome-rest/CHANGELOG.md",
        "$TURBO_ROOT$/apiome-ui/public/WHATS_NEW.md",
        "$TURBO_ROOT$/scripts/gen-release-notes.ts"
      ],
      "outputs": ["build/**"]
    },
    "@suite/designer#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@suite/designer#dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "cli:build": {
      "cache": false,
      "dependsOn": ["^cli:build"]
    },
    "cli:test": {
      "cache": true,
      "dependsOn": ["cli:build"]
    },
    "cli:lint": {
      "cache": true,
      "dependsOn": ["cli:build"]
    }
  }
}
