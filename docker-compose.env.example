# Copy to `.env` in the repo root (same directory as docker-compose.yml) to override defaults.

# Postgres (must match across postgres / migrate / mcp)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=apiome_local_dev
# POSTGRES_DB=apiome

# Host port mapping (optional)
# POSTGRES_PUBLISH_PORT=5432

# REST HTTP port on the host (apiome-rest always listens on 8000 in-container)
# APIOME_REST_HTTP_PORT=8000

# MCP HTTP port on the host (must match in-container APIOME_MCP_HTTP_PORT)
# APIOME_MCP_HTTP_PORT=8765

# Document store (COA-5.12, #7088): where imported originals and rendered documents are kept.
# `db` (default when unset) = Postgres; `s3` = the bundled MinIO below, or any S3-compatible
# service; `filesystem` = a directory (also set APIOME_DOCUMENT_STORE_PATH and mount a volume).
# `docker compose up` always starts MinIO and creates the bucket, so switching to it is one line:
# APIOME_DOCUMENT_STORE=s3
# MinIO root credentials (local development only) and host ports. REST uses the root user as its
# S3 key unless APIOME_DOCUMENT_STORE_ACCESS_KEY_ID / _SECRET_ACCESS_KEY are set.
# MINIO_ROOT_USER=apiome
# MINIO_ROOT_PASSWORD=apiome_local_dev
# MINIO_API_PUBLISH_PORT=9000
# MINIO_CONSOLE_PUBLISH_PORT=9001      # web console: http://localhost:9001
# Bucket (created by the minio-init service) and folder inside it.
# APIOME_DOCUMENT_STORE_BUCKET=apiome
# APIOME_DOCUMENT_STORE_PREFIX=apiome
# Point at another S3-compatible service instead of the bundled MinIO:
# APIOME_DOCUMENT_STORE_ENDPOINT_URL=http://minio:9000
# APIOME_DOCUMENT_STORE_REGION=us-east-1
# APIOME_DOCUMENT_STORE_ADDRESSING_STYLE=path
# APIOME_DOCUMENT_STORE_ALLOW_PRIVATE=true

# Mock HTTP port on the host (apiome-mock always listens on 8775 in-container)
# APIOME_MOCK_HTTP_PORT=8775
# Public mock base URL returned in version GET responses (REST control plane); the same
# value is passed to apiome-mcp as APIOME_MCP_MOCK_PUBLIC_BASE_URL, which is where AGX-2.4
# toolsets with target=mock send tools/call traffic.
# APIOME_MOCK_PUBLIC_BASE_URL=http://localhost:8775

# Dry-run mock preview (#5528, MSC-1.2). apiome-rest renders POST …/mock/preview by asking
# apiome-mock's internal /__preview__ endpoint, so it needs the mock service's *internal* address
# (compose DNS, not the public URL above) and a token both containers share. Compose supplies dev
# defaults for both; override the token for anything but local development. With either unset the
# preview endpoint fails closed with 503.
# APIOME_MOCK_INTERNAL_BASE_URL=http://mock:8775
# APIOME_MOCK_INTERNAL_TOKEN=replace-with-a-random-secret

# Required by apiome-mcp at runtime (min 16 characters); compose supplies a dev default
# APIOME_MCP_INTERNAL_SECRET=replace-with-at-least-16-chars

# apiome-rest auth/CORS hardening (see docs/security/AUTH_MODEL.md).
# The Postgres credentials above are DEV-ONLY defaults — override them for any non-local use.
# In production set APIOME_ENV=production AND a strong shared JWT secret, or REST refuses
# to start (it will not fall back to the insecure built-in default).
# APIOME_ENV=development
# BETTER_AUTH_SECRET=replace-with-output-of: openssl rand -base64 32
# APIOME_CORS_ALLOWED_ORIGINS=https://app.example.com

# Bundled-toolchain enforcement (FMT-1.3). The image ships @asyncapi/parser, which the AsyncAPI
# import adapter hard-requires (there is no fallback parser). Left at the image default (1),
# apiome-rest logs the parser version it resolved at startup and REFUSES to start if it cannot
# run it, rather than coming up with AsyncAPI import silently missing. Set to 0 only for a
# deliberately slimmed deployment that accepts losing AsyncAPI import; it then starts, logs the
# loss as an ERROR, and reports it in the `toolchain` block of GET /health.
# APIOME_REQUIRE_TOOLCHAIN=1

# Super-admin session, shared by apiome-ui and apiome-rest (OLO-8.4). The /admin settings
# screen calls `GET /api/admin/auth-providers` on apiome-ui, which forwards the signed
# `admin_session` token to apiome-rest, where it is verified AGAIN against apiome-rest's own
# copy of the key. Both resolve it the same way: ADMIN_SESSION_SECRET wins, else it is derived
# from ADMIN_PASSWORD. docker-compose.yml passes both variables from this file into the
# apiome-rest container, so setting them here keeps the two sides in sync.
#
# Leave both unset and apiome-rest fails closed: the settings screen 403s on every load
# (`GET /api/admin/auth-providers 403`) and reports an invalid/expired super-admin session
# immediately after a successful login. Setting them to values that DIFFER between the two
# services produces the same 403.
# ADMIN_PASSWORD=your_secure_admin_password_here
# ADMIN_SESSION_SECRET=replace-with-output-of: openssl rand -base64 48

# DB-over-env sign-in provider configuration, the rest of the set (OLO-8.3/8.5). Also passed
# through to apiome-rest by docker-compose.yml, and each must match apiome-ui byte for byte.
# AUTH_CONFIG_ENC_KEY seals client secrets saved from the admin screen — unset ⇒ saving a
# secret returns 503. INTERNAL_SERVICE_TOKEN gates the login-time resolved-config read —
# unset ⇒ 503 ⇒ sign-in silently keeps using the *_ID/*_SECRET env vars instead.
# AUTH_CONFIG_ENC_KEY=replace-with-output-of: openssl rand -base64 32
# INTERNAL_SERVICE_TOKEN=replace-with-output-of: openssl rand -base64 48

# Single sign-on (EID-1.2): the public email domains no workspace may claim. Comma-separated;
# setting it REPLACES the built-in list (gmail.com, outlook.com, yahoo.com, …).
# APIOME_SSO_PUBLIC_DOMAINS=gmail.com,outlook.com,yahoo.com

# apiome-rest MCP credential encryption-at-rest (MCAT-6.2, #3678). REQUIRED before a
# protected (authenticated) MCP server's credential can be stored — otherwise the API returns
# "MCP credential encryption is not configured; set APIOME_MCP_CREDENTIAL_ENCRYPTION_KEYS
# before storing a secret". JSON mapping an integer key-version to a base64 32-byte AES-256 key.
# Generate: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Quote JSON if this file is also sourced by a shell; Compose accepts either form:
# APIOME_MCP_CREDENTIAL_ENCRYPTION_KEYS={"1": "<base64 32-byte key>"}
# APIOME_MCP_CREDENTIAL_ENCRYPTION_KEYS='{"1": "<base64 32-byte key>"}'

# apiome-rest SDK registry credential encryption-at-rest (SDK-4.1, #4495). REQUIRED before a
# tenant's npm / PyPI publish token can be stored — otherwise the API answers 503 with
# "Registry credentials cannot be stored on this deployment". Same shape and same rotation story
# as the MCP keys above, but a SEPARATE key map on purpose: a publish token and an outbound MCP
# token are different blast radii.
# Generate: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# APIOME_SDK_REGISTRY_CREDENTIAL_ENCRYPTION_KEYS='{"1": "<base64 32-byte key>"}'
# Which key-version new credentials are sealed under. Optional; defaults to the highest present.
# APIOME_SDK_REGISTRY_CREDENTIAL_ACTIVE_KEY_VERSION=1

# apiome-rest agent upstream credential encryption-at-rest (AGX-2.2, #4534). REQUIRED before a
# tenant can store the apiKey / bearer / basic credential a managed MCP toolset presents to its
# real API — otherwise the API answers 503 with "Upstream credentials cannot be stored on this
# deployment". Same shape and rotation story as the keys above, but a SEPARATE key map on
# purpose: a production API credential is a different blast radius from a publish token.
# docker-compose.yml passes this through to the rest service; new credentials are sealed under
# the highest key version present.
# Generate: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# APIOME_UPSTREAM_CREDENTIAL_ENCRYPTION_KEYS='{"1": "<base64 32-byte key>"}'

# apiome-rest mock broker credential encryption-at-rest (XPC-2.1, #5735). REQUIRED before a tenant
# can bind a version's mock to its own Kafka cluster WITH a SASL credential — otherwise the API
# answers 503 broker-credential-encryption-unconfigured. A binding without SASL (such as the dev
# broker below) needs no key. A SEPARATE key map: a broker credential can write to production
# topics, its own blast radius. docker-compose.yml passes this through to the rest service.
# APIOME_BROKER_CREDENTIAL_ENCRYPTION_KEYS='{"1": "<base64 32-byte key>"}'
# The mock's Kafka producer (XPC-2.2, #5736) reads the same value to open those credentials; the
# compose file passes it to both rest and mock. Turn the periodic producer off on all but one
# replica of a multi-replica mock deployment:
# APIOME_MOCK_BROKER_PRODUCER_ENABLED=true
#
# The opt-in dev broker: `docker compose --profile broker up --build --wait` starts a single-node
# Redpanda at redpanda:9092 inside the stack (localhost:19092 from the host). rest and mock are
# pre-wired with that address; override only if you run the broker elsewhere.
# APIOME_MOCK_DEV_BROKER_BOOTSTRAP=redpanda:9092
# APIOME_DEV_BROKER_HOST_PORT=19092
# Local escape hatch: allow broker bindings to private addresses (a broker on your own network).
# Default false; never enable it on a shared deployment.
# APIOME_MOCK_BROKER_ALLOW_PRIVATE=false

# apiome-rest Slate CDN credential encryption-at-rest (Slate 10.2, private-suite#120). REQUIRED
# before a tenant can attach a CDN provider (Cloudflare API token, Fastly API key or custom purge
# secret) to a hosted Slate lane — otherwise saving answers 409 cdn-vault-not-configured. A
# SEPARATE key map: a CDN token can flush a production cache, its own blast radius.
# docker-compose.yml passes this through to the rest service.
# Generate: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# APIOME_SLATE_CDN_CREDENTIAL_ENCRYPTION_KEYS='{"1": "<base64 32-byte key>"}'

# Linked-account token encryption-at-rest (#4960). Seals the OAuth access / refresh tokens and
# personal access tokens of linked accounts (external_auth_providers). apiome-ui seals them and
# apiome-rest opens them, so set the SAME value in apiome-ui/.env; docker-compose.yml passes this
# one through to the rest service. Unset ⇒ sign-in still works, but no provider token is stored
# (private-repository scans report a missing token) and saving a personal access token is refused.
# JSON mapping an integer key-version to a base64 32-byte AES-256 key; rotate by adding a higher
# version, then run `python -m app.seal_linked_account_tokens` in apiome-rest.
# Generate: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# APIOME_LINKED_ACCOUNT_TOKEN_ENCRYPTION_KEYS='{"1": "<base64 32-byte key>"}'

# Optional apiome-mcp overrides (defaults documented in apiome-mcp/docs/CONFIGURATION.md)
# APIOME_MCP_LOG_LEVEL=INFO
# APIOME_MCP_DATABASE_POOL_MIN_SIZE=1
# APIOME_MCP_DATABASE_POOL_MAX_SIZE=10
# APIOME_MCP_DATABASE_POOL_TIMEOUT=30
# APIOME_MCP_OPENAPI_MAX_JSON_BYTES=2097152
