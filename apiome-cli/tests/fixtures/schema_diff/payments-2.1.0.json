{
  "openapi": "3.1.0",
  "info": {
    "title": "Payments",
    "version": "2.1.0"
  },
  "paths": {
    "/charges": {
      "get": {
        "summary": "List charges",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Charge"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a card charge",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Charge"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get a customer",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          }
        }
      }
    },
    "/refunds": {
      "post": {
        "summary": "Create a refund",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          }
        }
      }
    },
    "/refunds/{id}": {
      "get": {
        "summary": "Get a refund",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Charge": {
        "type": "object",
        "description": "A card charge.",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "currency": {
            "type": "string"
          },
          "refunded": {
            "type": "boolean"
          }
        }
      },
      "Customer": {
        "type": "object",
        "description": "A customer.",
        "properties": {
          "email": {
            "type": "string",
            "description": "Primary email address."
          }
        }
      },
      "Refund": {
        "type": "object",
        "properties": {
          "charge_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "integer"
          }
        }
      }
    }
  }
}
