{
  "openapi": "3.1.0",
  "info": {
    "title": "Payments",
    "version": "2.0.0"
  },
  "paths": {
    "/charges": {
      "get": {
        "summary": "List charges",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Charge"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a charge",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Charge"
                }
              }
            }
          }
        }
      }
    },
    "/v1/charges/legacy": {
      "get": {
        "summary": "Legacy list",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/customers/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get a customer",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Charge": {
        "type": "object",
        "description": "A card charge.",
        "properties": {
          "amount": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "legacy_code": {
            "type": "string"
          }
        }
      },
      "Customer": {
        "type": "object",
        "description": "A customer.",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email."
          }
        }
      },
      "Payout": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer"
          }
        }
      }
    }
  }
}
