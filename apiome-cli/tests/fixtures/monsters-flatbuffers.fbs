// FlatBuffers schema for the CLI tests (MFI-19.4): a namespace, an enum, a struct, a union, a table
// with explicit field ids and a deprecated slot, and the root type.
namespace Game.Monsters;

enum Color : byte { Red = 0, Green = 1, Blue = 2 }

struct Vec3 {
  x: float;
  y: float;
  z: float;
}

table Sword {
  damage: short;
}

table Shield {
  armor: short;
}

union Equipment { Sword, Shield }

table Monster {
  pos: Vec3 (id: 0);
  mana: short = 150 (id: 1);
  hp: short = 100 (id: 2);
  name: string (id: 3);
  friendly: bool = false (id: 4, deprecated);
  color: Color = Blue (id: 5);
  // A union takes two ids: `equipped_type` (6, generated by flatc) and `equipped` (7).
  equipped: Equipment (id: 7);
}

root_type Monster;
