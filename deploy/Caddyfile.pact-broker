# Caddy for the self-hosted Pact Broker stack (docker-compose.pact-broker.yml, PFX-6.8, #6960).
# One site: the broker API. Certificates are issued and renewed automatically.
{
	email {$ACME_EMAIL}
}

{$BROKER_DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy rest:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		health_uri /livez
		health_interval 10s
		health_timeout 4s
	}
}
