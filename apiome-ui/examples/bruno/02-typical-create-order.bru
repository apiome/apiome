meta {
  name: Create order
  type: http
  seq: 3
}

post {
  url: https://shop.example.com/v2/orders?notify=true
  body: json
  auth: bearer
}

params:query {
  notify: true
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
}

auth:bearer {
  token: demo-bearer-not-real
}

body:json {
  {
    "customer_id": "cus_123",
    "lines": [
      { "sku": "SKU-1", "qty": 2, "price": 9.5 }
    ],
    "gift": false
  }
}

vars:pre-request {
  idempotencyKey: order-0001
}

assert {
  res.status: eq 201
  res.body.id: isString
}
