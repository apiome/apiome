{
  "_comment": "FHIR R5 example — the 08 Patient profile re-published for R5 5.0.0: same canonical url, a new version, birthDate made required and a telecom element added. No third-party text copied.",
  "resourceType": "StructureDefinition",
  "id": "example-patient",
  "url": "https://profiles.example.org/fhir/StructureDefinition/example-patient",
  "version": "2.0.0",
  "name": "ExamplePatient",
  "status": "active",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Patient",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Patient",
  "derivation": "constraint",
  "differential": {
    "element": [
      { "id": "Patient.identifier", "path": "Patient.identifier", "short": "Medical record number", "min": 1, "max": "*", "type": [{ "code": "Identifier" }] },
      { "id": "Patient.name", "path": "Patient.name", "short": "Legal name", "min": 1, "max": "*", "type": [{ "code": "HumanName" }] },
      { "id": "Patient.gender", "path": "Patient.gender", "short": "Administrative gender", "min": 1, "max": "1", "type": [{ "code": "code" }] },
      { "id": "Patient.birthDate", "path": "Patient.birthDate", "short": "Date of birth", "min": 1, "max": "1", "type": [{ "code": "date" }] },
      { "id": "Patient.telecom", "path": "Patient.telecom", "short": "Contact details", "min": 0, "max": "*", "type": [{ "code": "ContactPoint" }] }
    ]
  }
}
