        "path": "asyncapi.json",
        "text": "{\n  \"asyncapi\": \"3.1.0\",\n  \"info\": {\n    \"title\": \"Order Service\",\n    \"version\": \"2.0.0\",\n    \"description\": \"Streams order lifecycle events to fulfilment and analytics.\"\n  },\n  \"servers\": {\n    \"production\": {\n      \"host\": \"broker.example.com:9092\",\n      \"protocol\": \"kafka\",\n      \"description\": \"Production Kafka cluster.\"\n    }\n  },\n  \"channels\": {\n    \"orderPlaced\": {\n      \"address\": \"order/placed\",\n      \"description\": \"An order was placed by a customer.\",\n      \"messages\": {\n        \"orderPlaced\": {\n          \"title\": \"Order placed\",\n          \"name\": \"orderPlaced\",\n          \"payload\": {\n            \"type\": \"object\",\n            \"description\": \"Details of a placed order.\",\n            \"required\": [\n              \"orderId\",\n              \"customerId\",\n              \"total\",\n              \"placedAt\"\n            ],\n            \"properties\": {\n              \"orderId\": {\n                \"type\": \"string\",\n                \"format\": \"uuid\",\n                \"description\": \"Unique order identifier.\"\n              },\n              \"customerId\": {\n                \"type\": \"string\",\n                \"format\": \"uuid\",\n                \"description\": \"Customer who placed the order.\"\n              },\n              \"total\": {\n                \"type\": \"number\",\n                \"format\": \"double\",\n                \"description\": \"Order total in the order currency.\"\n              },\n              \"currency\": {\n                \"type\": \"string\",\n                \"description\": \"ISO 4217 currency code.\",\n                \"default\": \"USD\"\n              },\n              \"placedAt\": {\n                \"type\": \"string\",\n                \"format\": \"date-time\",\n                \"description\": \"When the order was placed.\"\n              }\n            }\n          },\n          \"contentType\": \"application/json\"\n        }\n      }\n    },\n    \"orderShipped\": {\n      \"address\": \"order/shipped\",\n      \"description\": \"An order was handed to the carrier.\",\n      \"messages\": {\n        \"orderShipped\": {\n          \"title\": \"Order shipped\",\n          \"name\": \"orderShipped\",\n          \"payload\": {\n            \"type\": \"object\",\n            \"description\": \"Shipment details for an order.\",\n            \"required\": [\n              \"orderId\",\n              \"trackingNumber\",\n              \"shippedAt\"\n            ],\n            \"properties\": {\n              \"orderId\": {\n                \"type\": \"string\",\n                \"format\": \"uuid\",\n                \"description\": \"The order being shipped.\"\n              },\n              \"trackingNumber\": {\n                \"type\": \"string\",\n                \"description\": \"Carrier tracking number.\"\n              },\n              \"carrier\": {\n                \"type\": \"string\",\n                \"description\": \"Shipping carrier name.\"\n              },\n              \"shippedAt\": {\n                \"type\": \"string\",\n                \"format\": \"date-time\",\n                \"description\": \"When the shipment left the warehouse.\"\n              }\n            }\n          },\n          \"contentType\": \"application/json\"\n        }\n      }\n    }\n  },\n  \"operations\": {\n    \"receiveOrderPlaced\": {\n      \"action\": \"receive\",\n      \"channel\": {\n        \"$ref\": \"#/channels/orderPlaced\"\n      },\n      \"messages\": [\n        {\n          \"$ref\": \"#/channels/orderPlaced/messages/orderPlaced\"\n        }\n      ],\n      \"description\": \"Handle a newly placed order.\"\n    },\n    \"receiveOrderShipped\": {\n      \"action\": \"receive\",\n      \"channel\": {\n        \"$ref\": \"#/channels/orderShipped\"\n      },\n      \"messages\": [\n        {\n          \"$ref\": \"#/channels/orderShipped/messages/orderShipped\"\n        }\n      ],\n      \"description\": \"Handle a shipped order.\"\n    }\n  }\n}"
      }
    ]
  },
