    "files": [
      {
        "path": "api.proto",
        "text": "syntax = \"proto3\";\n\nimport \"google/protobuf/empty.proto\";\n\nmessage Category {\n  string description = 1;\n  int64 id = 2;\n  string name = 3;\n}\n\nmessage Pet {\n  // Age of the pet (must be positive)\n  int32 age = 1;\n  .Category category = 2;\n  // Unique identifier for the pet\n  int64 id = 3;\n  // Name of the pet\n  string name = 4;\n  // Optional tag for categorization\n  string tag = 5;\n  // Weight in kilograms (must be less than 500)\n  double weight = 6;\n}\n\nservice default {\n  // Delete a pet\n  rpc deletePet (.google.protobuf.Empty) returns (.google.protobuf.Empty);\n  // List all pets\n  rpc listPets (.google.protobuf.Empty) returns (.google.protobuf.Empty);\n  // Get a pet by ID\n  rpc getPetById (.google.protobuf.Empty) returns (.Pet);\n  // Create a new pet\n  rpc createPet (.Pet) returns (.Pet);\n  // Update a pet by ID\n  rpc updatePet (.Pet) returns (.Pet);\n}\n"
      }
    ]
  },
