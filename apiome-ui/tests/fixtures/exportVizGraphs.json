        "path": "order-service.xregistry.json",
        "text": "{\n  \"specversion\": \"1.0-rc1\",\n  \"registryid\": \"order-service\",\n  \"name\": \"Order Service\",\n  \"description\": \"Streams order lifecycle events to fulfilment and analytics.\",\n  \"messagegroups\": {\n    \"default\": {\n      \"messagegroupid\": \"default\",\n      \"envelope\": \"CloudEvents/1.0\",\n      \"messages\": {\n        \"receiveOrderPlaced\": {\n          \"messageid\": \"receiveOrderPlaced\",\n          \"name\": \"orderPlaced\",\n          \"description\": \"Handle a newly placed order.\",\n          \"envelope\": \"CloudEvents/1.0\",\n          \"envelopemetadata\": {\n            \"type\": {\n              \"value\": \"order/placed\"\n            },\n            \"source\": {\n              \"value\": \"/order-service\"\n            }\n          },\n          \"datacontenttype\": \"application/json\",\n          \"dataschemaformat\": \"JsonSchema/draft/2020-12\",\n          \"dataschema\": {\n            \"type\": \"object\",\n            \"description\": \"Details of a placed order.\",\n            \"required\": [\n              \"orderId\",\n              \"customerId\",\n              \"total\",\n              \"placedAt\"\n            ],\n            \"properties\": {\n              \"orderId\": {\n                \"type\": \"string\",\n                \"format\": \"uuid\",\n                \"description\": \"Unique order identifier.\"\n              },\n              \"customerId\": {\n                \"type\": \"string\",\n                \"format\": \"uuid\",\n                \"description\": \"Customer who placed the order.\"\n              },\n              \"total\": {\n                \"type\": \"number\",\n                \"format\": \"double\",\n                \"description\": \"Order total in the order currency.\"\n              },\n              \"currency\": {\n                \"type\": \"string\",\n                \"description\": \"ISO 4217 currency code.\",\n                \"default\": \"USD\"\n              },\n              \"placedAt\": {\n                \"type\": \"string\",\n                \"format\": \"date-time\",\n                \"description\": \"When the order was placed.\"\n              }\n            }\n          }\n        },\n        \"receiveOrderShipped\": {\n          \"messageid\": \"receiveOrderShipped\",\n          \"name\": \"orderShipped\",\n          \"description\": \"Handle a shipped order.\",\n          \"envelope\": \"CloudEvents/1.0\",\n          \"envelopemetadata\": {\n            \"type\": {\n              \"value\": \"order/shipped\"\n            },\n            \"source\": {\n              \"value\": \"/order-service\"\n            }\n          },\n          \"datacontenttype\": \"application/json\",\n          \"dataschemaformat\": \"JsonSchema/draft/2020-12\",\n          \"dataschema\": {\n            \"type\": \"object\",\n            \"description\": \"Shipment details for an order.\",\n            \"required\": [\n              \"orderId\",\n              \"trackingNumber\",\n              \"shippedAt\"\n            ],\n            \"properties\": {\n              \"orderId\": {\n                \"type\": \"string\",\n                \"format\": \"uuid\",\n                \"description\": \"The order being shipped.\"\n              },\n              \"trackingNumber\": {\n                \"type\": \"string\",\n                \"description\": \"Carrier tracking number.\"\n              },\n              \"carrier\": {\n                \"type\": \"string\",\n                \"description\": \"Shipping carrier name.\"\n              },\n              \"shippedAt\": {\n                \"type\": \"string\",\n                \"format\": \"date-time\",\n                \"description\": \"When the shipment left the warehouse.\"\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n"
