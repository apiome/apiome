  "script": "-- Shop: SQL DDL (postgres), generated by Apiome.\nCREATE TABLE order_lines (\n  order_id BIGINT NOT NULL,\n  order_line_id BIGINT NOT NULL,\n  position INTEGER NOT NULL,\n  PRIMARY KEY (order_id, position)\n);\n\nCREATE TABLE order_tags (\n  order_id BIGINT NOT NULL,\n  position INTEGER NOT NULL,\n  \"value\" TEXT,\n  PRIMARY KEY (order_id, position)\n);\n\nCREATE TABLE \"order\" (\n  id BIGINT GENERATED BY DEFAULT AS IDENTITY NOT NULL,\n  \"user\" TEXT NOT NULL,\n  ship_to_id BIGINT,\n  PRIMARY KEY (id)\n);\n\nCREATE TABLE order_line (\n  id BIGINT GENERATED BY DEFAULT AS IDENTITY NOT NULL,\n  sku TEXT NOT NULL,\n  PRIMARY KEY (id)\n);\n\nCREATE TABLE address (\n  id BIGINT NOT NULL,\n  city TEXT,\n  PRIMARY KEY (id)\n);\n\nALTER TABLE order_lines ADD CONSTRAINT fk_order_lines_1 FOREIGN KEY (order_id) REFERENCES \"order\" (id);\n\nALTER TABLE order_lines ADD CONSTRAINT fk_order_lines_2 FOREIGN KEY (order_line_id) REFERENCES order_line (id);\n\nALTER TABLE order_tags ADD CONSTRAINT fk_order_tags_1 FOREIGN KEY (order_id) REFERENCES \"order\" (id);\n\nALTER TABLE \"order\" ADD CONSTRAINT fk_order_1 FOREIGN KEY (ship_to_id) REFERENCES address (id);\n",
  "filename": "Shop.sql"
