# Environment template for the self-hosted Pact Broker (docker-compose.pact-broker.yml, #6960).
# Copy to `.env` next to the compose file and fill in every value. There are no safe defaults: the
# stack refuses to start when a required value is missing. The real `.env` holds live secrets and
# must not be committed.

# Public hostname. Its DNS A/AAAA record must point at this host before first boot so Caddy can
# complete the Let's Encrypt challenge on ports 80/443.
BROKER_DOMAIN=pacts.example.com
# Contact address Let's Encrypt uses for certificate-expiry notices.
ACME_EMAIL=ops@example.com

# Strong database password — openssl rand -base64 24
POSTGRES_PASSWORD=
# Optional (defaults shown).
# POSTGRES_USER=postgres
# POSTGRES_DB=apiome

# Signs the REST tokens — openssl rand -base64 32
BETTER_AUTH_SECRET=

# Browser origins allowed to call the API. Defaults to https://$BROKER_DOMAIN; the Pact CLI and
# libraries are not browsers and ignore it.
# APIOME_CORS_ALLOWED_ORIGINS=https://pacts.example.com

# Backups (profile `ops`). The encryption key is the recovery dependency: keep it in a secret
# manager, not on this host — openssl rand -hex 32
APIOME_BACKUP_KEY=
# APIOME_BACKUP_KEEP_DAYS=30
# APIOME_BACKUP_KEEP_LAST=7
