# apiome-browse configuration
#
# Copy this file to `.env` and adjust the values, then restart the app:
#   cp .env.example .env
#
# Next.js loads `.env` automatically for `yarn dev`, `yarn build`, and `yarn start`.
# The `yarn docker:run` script also passes it to the container via `--env-file .env`.

# ---------------------------------------------------------------------------
# REST API  (required)
# ---------------------------------------------------------------------------
# Base URL of the apiome-rest API, including the `/v1` suffix.
#
# Browse builds the OpenAPI, Swagger, Arazzo, and JSON-Schema spec links from this
# value. When it is unset the app falls back to http://localhost:8000/v1 — which is
# exactly why those links point at localhost. Set this to the URL of your REST API
# as reached FROM THE USER'S BROWSER (these specs are fetched/downloaded client-side),
# so it must be publicly reachable and have CORS configured for this site's origin.
#
# Examples:
#   NEXT_PUBLIC_REST_API_BASE_URL=https://api.example.com/v1
#   NEXT_PUBLIC_REST_API_BASE_URL=http://localhost:8000/v1   # local development
NEXT_PUBLIC_REST_API_BASE_URL=http://localhost:8000/v1

# ---------------------------------------------------------------------------
# Mock server  (optional)
# ---------------------------------------------------------------------------
# Public base URL of the apiome-mock server (no trailing slash). Version pages use it
# to surface the "Mock available" badge, the mock base URL, and the copyable curl
# one-liner when a version's mock is enabled — the composed URL is
# {APIOME_MOCK_PUBLIC_BASE_URL}/{tenant}/{project}/{version}. Set it to the URL the
# mock is reached at FROM THE USER'S BROWSER/TERMINAL (consumers copy and curl it).
# Read server-side at render time; defaults to http://localhost:8775 when unset.
#
# Examples:
#   APIOME_MOCK_PUBLIC_BASE_URL=https://mock.example.com
#   APIOME_MOCK_PUBLIC_BASE_URL=http://localhost:8775   # local development
# APIOME_MOCK_PUBLIC_BASE_URL=http://localhost:8775

# ---------------------------------------------------------------------------
# Hosting sub-path  (optional)
# ---------------------------------------------------------------------------
# Serve the app under a sub-path (e.g. https://example.com/browse). Leave unset to
# serve from the root. This is applied at BUILD time (next.config.ts), so set it
# before `yarn build` / building the Docker image.
# NEXT_PUBLIC_BASE_PATH=/browse

# ---------------------------------------------------------------------------
# Database (PostgreSQL)  — server-side only
# ---------------------------------------------------------------------------
# Browse reads catalog data directly from the apiome database. Provide EITHER
# a single DATABASE_URL, OR the discrete POSTGRES_* settings below (the discrete
# values take precedence when both are set).
#
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/apiome

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apiome
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Connections this Browse process may hold (default 10). Count DB_POOL_MAX × Browse instances
# against PostgreSQL's max_connections.
# DB_POOL_MAX=10

# Milliseconds one statement may run before PostgreSQL cancels it (default 30000, 0 = no limit).
# A search that runs longer shows an error page with a "Try again" button.
# DB_STATEMENT_TIMEOUT_MS=30000

# Seconds the directory counts in the top bar and the home page's lists are reused before they are
# read again (default 120, at most 300, 0 = read on every page view). A newly published version can
# take this long to be counted; its own page and search show it at once.
# BROWSE_CACHE_TTL_SECONDS=120
