{
  "mappingVersion": 1,
  "tools": [
    {
      "description": "Disable a user\n\nReturns HTTP 204 with no body: Disabled",
      "inputSchema": {
        "properties": {
          "login": {
            "type": "string"
          }
        },
        "required": [
          "login"
        ],
        "type": "object"
      },
      "name": "disableUser",
      "operation": "DELETE /users/{login}",
      "output": {
        "description": "Disabled",
        "status": "204"
      }
    },
    {
      "description": "List users in the directory\n\nReturns HTTP 200 application/json (array of User): A page of users",
      "inputSchema": {
        "properties": {
          "cursor": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "includeDisabled": {
            "default": false,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "listUsers",
      "operation": "GET /users",
      "output": {
        "description": "A page of users",
        "mediaType": "application/json",
        "schema": {
          "items": {
            "properties": {
              "createdAt": {
                "format": "date-time",
                "type": "string"
              },
              "department": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "groups": {
                "items": {
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "login": {
                "type": "string"
              }
            },
            "required": [
              "displayName",
              "enabled",
              "login"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "shape": "array of User",
        "status": "200"
      }
    },
