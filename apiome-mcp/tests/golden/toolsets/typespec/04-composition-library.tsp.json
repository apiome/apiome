{
  "mappingVersion": 1,
  "tools": [
    {
      "description": "List all books.\n\nReturns HTTP 200 application/json (array of Library.Book).",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "name": "list",
      "operation": "GET /books",
      "output": {
        "mediaType": "application/json",
        "schema": {
          "items": {
            "description": "A book composed from the shared base models plus its own fields.",
            "properties": {
              "author": {
                "type": "string"
              },
              "isbn": {
                "type": "string"
              },
              "publisher": {
                "description": "A publisher, nested inside Book as a model-typed field.",
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "author",
              "publisher",
              "title"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "shape": "array of Library.Book",
        "status": "200"
      }
    },
    {
      "description": "Fetch a book by id.\n\nReturns HTTP 200 application/json (Library.Book).",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "read",
      "operation": "GET /books/{id}",
      "output": {
        "mediaType": "application/json",
        "schema": {
          "description": "A book composed from the shared base models plus its own fields.",
          "properties": {
            "author": {
              "type": "string"
            },
            "isbn": {
              "type": "string"
            },
            "publisher": {
              "description": "A publisher, nested inside Book as a model-typed field.",
              "properties": {
                "country": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "author",
            "publisher",
            "title"
          ],
          "type": "object"
        },
        "shape": "Library.Book",
        "status": "200"
      }
    },
    {
      "description": "Fetch a borrower by id.\n\nReturns HTTP 200 application/json (Library.Borrower).",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "read_2",
      "operation": "GET /borrowers/{id}",
      "output": {
        "mediaType": "application/json",
        "schema": {
          "description": "A borrower record reusing the same shared base models.",
          "properties": {
            "email": {
              "type": "string"
            },
            "fullName": {
              "type": "string"
            }
          },
          "required": [
            "email",
            "fullName"
          ],
          "type": "object"
        },
        "shape": "Library.Borrower",
        "status": "200"
      }
    }
  ]
}
