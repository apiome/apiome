{
  "mappingVersion": 1,
  "tools": [
    {
      "description": "Decommission a device.",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "remove",
      "operation": "DELETE /devices/{id}"
    },
    {
      "description": "List devices, filtered by state and paged with a query cursor.\n\nReturns HTTP 200 application/json (array of DeviceFleet.Device).",
      "inputSchema": {
        "properties": {
          "cursor": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "cursor",
          "state"
        ],
        "type": "object"
      },
      "name": "list",
      "operation": "GET /devices",
      "output": {
        "mediaType": "application/json",
        "schema": {
          "items": {
            "description": "A managed device in the fleet.",
            "properties": {
              "batteryPercent": {},
              "firmwareVersion": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "lastSeen": {},
              "serialNumber": {
                "type": "string"
              },
              "shadowEnabled": {},
              "state": {
                "description": "Operational state reported by a device.",
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "integer"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "id",
              "serialNumber",
              "shadowEnabled",
              "state",
              "tags"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "shape": "array of DeviceFleet.Device",
        "status": "200"
      }
    },
    {
      "description": "Fetch one device; supports conditional reads via an entity-tag header.\n\nReturns HTTP 200 application/json (DeviceFleet.Device).",
      "inputSchema": {
        "properties": {
          "id": {
            "type": "string"
          },
          "ifNoneMatch": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "ifNoneMatch"
        ],
        "type": "object"
      },
      "name": "read",
      "operation": "GET /devices/{id}",
      "output": {
        "mediaType": "application/json",
        "schema": {
          "description": "A managed device in the fleet.",
          "properties": {
            "batteryPercent": {},
            "firmwareVersion": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "lastSeen": {},
            "serialNumber": {
              "type": "string"
            },
            "shadowEnabled": {},
            "state": {
              "description": "Operational state reported by a device.",
              "enum": [
                0,
                1,
                2,
                3
              ],
              "type": "integer"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "id",
            "serialNumber",
            "shadowEnabled",
            "state",
            "tags"
          ],
          "type": "object"
        },
        "shape": "DeviceFleet.Device",
        "status": "200"
      }
    },
    {
      "description": "Apply a sparse update to a device.\n\nReturns HTTP 200 application/json (DeviceFleet.Device).",
      "inputSchema": {
        "properties": {
          "firmwareVersion": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "shadowEnabled": {},
          "state": {
            "description": "Operational state reported by a device.",
            "enum": [
              0,
              1,
              2,
              3
            ],
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "update",
      "operation": "PATCH /devices/{id}",
      "output": {
        "mediaType": "application/json",
        "schema": {
          "description": "A managed device in the fleet.",
          "properties": {
            "batteryPercent": {},
            "firmwareVersion": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "lastSeen": {},
            "serialNumber": {
              "type": "string"
            },
            "shadowEnabled": {},
            "state": {
              "description": "Operational state reported by a device.",
              "enum": [
                0,
                1,
                2,
                3
              ],
              "type": "integer"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "id",
            "serialNumber",
            "shadowEnabled",
            "state",
            "tags"
          ],
          "type": "object"
        },
        "shape": "DeviceFleet.Device",
        "status": "200"
      }
    },
    {
      "description": "Start a firmware rollout across the fleet.\n\nReturns HTTP 200 application/json (DeviceFleet.RolloutSummary).",
      "inputSchema": {
        "properties": {
          "dryRun": {},
          "maxFailuresPercent": {},
          "targetVersion": {
            "type": "string"
          }
        },
        "required": [
          "dryRun",
          "maxFailuresPercent",
          "targetVersion"
        ],
        "type": "object"
      },
      "name": "create",
      "operation": "POST /rollouts",
      "output": {
        "mediaType": "application/json",
        "schema": {
          "description": "Summary returned by the rollout endpoint.",
          "properties": {
            "deviceCount": {},
            "rolloutId": {
              "type": "string"
            }
          },
          "required": [
            "deviceCount",
            "rolloutId"
          ],
          "type": "object"
        },
        "shape": "DeviceFleet.RolloutSummary",
        "status": "200"
      }
    }
  ]
}
