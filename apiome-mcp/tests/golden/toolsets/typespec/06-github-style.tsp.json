{
  "mappingVersion": 1,
  "tools": [
    {
      "description": "List issues for a repository.\n\nReturns HTTP 200 application/json (array of GitHubStyle.Issue).",
      "inputSchema": {
        "properties": {
          "fullName": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "fullName",
          "state"
        ],
        "type": "object"
      },
      "name": "list",
      "operation": "GET /repos/{fullName}",
      "output": {
        "mediaType": "application/json",
        "schema": {
          "items": {
            "description": "An issue on a repository.",
            "properties": {
              "body": {
                "type": "string"
              },
              "createdAt": {},
              "issueNumber": {},
              "labels": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "state": {
                "description": "Issue lifecycle state.",
                "enum": [
                  0,
                  1
                ],
                "type": "integer"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "createdAt",
              "issueNumber",
              "labels",
              "state",
              "title"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "shape": "array of GitHubStyle.Issue",
        "status": "200"
      }
    },
    {
