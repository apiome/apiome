{
  "mappingVersion": 1,
  "tools": [
    {
      "description": "Delete a pet\n\nReturns HTTP 204 with no body: Pet deleted",
      "inputSchema": {
        "properties": {
          "petId": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "petId"
        ],
        "type": "object"
      },
      "name": "deletePet",
      "operation": "DELETE /pets/{petId}",
      "output": {
        "description": "Pet deleted",
        "status": "204"
      }
    },
    {
      "description": "List all pets\n\nReturns HTTP 200 application/json (array of Pet): A paged array of pets",
      "inputSchema": {
        "properties": {
          "limit": {
            "description": "How many items to return at one time",
            "format": "int32",
            "maximum": 100.0,
            "minimum": 1.0,
            "type": "integer"
          },
          "status": {
            "description": "Filter by status",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "name": "listPets",
      "operation": "GET /pets",
      "output": {
        "description": "A paged array of pets",
        "mediaType": "application/json",
        "schema": {
          "items": {
            "description": "A pet in the store",
            "properties": {
              "category": {
                "description": "A category for a pet",
                "properties": {
                  "id": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "createdAt": {
                "description": "When the pet was created",
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "description": "Unique identifier for the pet",
                "format": "int64",
                "type": "integer"
              },
              "metadata": {
                "description": "Additional metadata"
              },
              "name": {
                "description": "Name of the pet",
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "photoUrls": {
                "description": "URLs of pet photos",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "status": {
                "description": "Pet status in the store",
                "enum": [
                  "available",
                  "pending",
                  "sold"
                ],
                "type": "string"
              },
              "tag": {
                "description": "Optional tag for the pet",
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "shape": "array of Pet",
        "status": "200"
      }
    },
