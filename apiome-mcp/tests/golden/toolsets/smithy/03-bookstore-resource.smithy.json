{
  "mappingVersion": 1,
  "tools": [
    {
      "description": "Add a new book to the catalog.\n\nReturns example.bookstore.BookSummary.",
      "inputSchema": {
        "properties": {
          "author": {
            "type": "string"
          },
          "isbn": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "author",
          "title"
        ],
        "type": "object"
      },
      "name": "CreateBook",
      "operation": "example.bookstore.BookstoreService.CreateBook",
      "output": {
        "schema": {
          "description": "Shared representation of a book, reused by read and list operations.",
          "properties": {
            "author": {
              "type": "string"
            },
            "bookId": {
              "type": "string"
            },
            "isbn": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "author",
            "bookId",
            "title"
          ],
          "type": "object"
        },
        "shape": "example.bookstore.BookSummary"
      }
    },
    {
      "description": "Fetch a single book by id.\n\nReturns example.bookstore.BookSummary.",
      "inputSchema": {
        "properties": {
          "bookId": {
            "type": "string"
          }
        },
        "required": [
          "bookId"
        ],
        "type": "object"
      },
      "name": "GetBook",
      "operation": "example.bookstore.BookstoreService.GetBook",
      "output": {
        "schema": {
          "description": "Shared representation of a book, reused by read and list operations.",
          "properties": {
            "author": {
              "type": "string"
            },
            "bookId": {
              "type": "string"
            },
            "isbn": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "author",
            "bookId",
            "title"
          ],
          "type": "object"
        },
        "shape": "example.bookstore.BookSummary"
      }
    },
    {
      "description": "List all books in the catalog.\n\nReturns example.bookstore.ListBooksOutput.",
      "inputSchema": {
        "properties": {
          "pageSize": {
            "type": "integer"
          },
          "pageToken": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "ListBooks",
      "operation": "example.bookstore.BookstoreService.ListBooks",
      "output": {
        "schema": {
          "properties": {
            "books": {
              "items": {
                "description": "Shared representation of a book, reused by read and list operations.",
                "properties": {
                  "author": {
                    "type": "string"
                  },
                  "bookId": {
                    "type": "string"
                  },
                  "isbn": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "author",
                  "bookId",
                  "title"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "nextPageToken": {
              "type": "string"
            }
          },
          "required": [
            "books"
          ],
          "type": "object"
        },
        "shape": "example.bookstore.ListBooksOutput"
      }
    }
  ]
}
