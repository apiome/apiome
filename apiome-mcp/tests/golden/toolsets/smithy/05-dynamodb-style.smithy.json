{
  "mappingVersion": 1,
  "tools": [
    {
      "description": "Fetch a single item by its primary key.\n\nReturns example.dynamodb.GetItemOutput.",
      "inputSchema": {
        "properties": {
          "consistentRead": {
            "type": "boolean"
          },
          "tableName": {
            "type": "string"
          }
        },
        "required": [
          "tableName"
        ],
        "type": "object"
      },
      "name": "GetItem",
      "operation": "example.dynamodb.DynamoDbLike.GetItem",
      "output": {
        "schema": {
          "properties": {
            "item": {
              "additionalProperties": {
                "description": "A single DynamoDB-style attribute value; exactly one member is set."
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "shape": "example.dynamodb.GetItemOutput"
      }
    },
    {
      "description": "Store an item in a table, replacing any existing item with the same key.\n\nReturns example.dynamodb.PutItemOutput.",
      "inputSchema": {
        "properties": {
          "item": {
            "additionalProperties": {
              "description": "A single DynamoDB-style attribute value; exactly one member is set."
            },
            "type": "object"
          },
          "tableName": {
            "type": "string"
          }
        },
        "required": [
          "item",
          "tableName"
        ],
        "type": "object"
      },
      "name": "PutItem",
      "operation": "example.dynamodb.DynamoDbLike.PutItem",
      "output": {
        "schema": {
          "properties": {
            "consumedCapacityUnits": {}
          },
          "type": "object"
        },
        "shape": "example.dynamodb.PutItemOutput"
      }
    },
    {
      "description": "Query items sharing a partition key.\n\nReturns example.dynamodb.QueryOutput.",
      "inputSchema": {
        "properties": {
          "expressionValues": {
            "additionalProperties": {
              "description": "A single DynamoDB-style attribute value; exactly one member is set."
            },
            "type": "object"
          },
          "keyConditionExpression": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "scanIndexForward": {
            "type": "boolean"
          },
          "tableName": {
            "type": "string"
          }
        },
        "required": [
          "keyConditionExpression",
          "tableName"
        ],
        "type": "object"
      },
      "name": "Query",
      "operation": "example.dynamodb.DynamoDbLike.Query",
      "output": {
        "schema": {
          "properties": {
            "count": {
              "type": "integer"
            },
            "items": {
              "items": {
                "additionalProperties": {
                  "description": "A single DynamoDB-style attribute value; exactly one member is set."
                },
                "type": "object"
              },
              "type": "array"
            },
            "lastEvaluatedKey": {
              "additionalProperties": {
                "description": "A single DynamoDB-style attribute value; exactly one member is set."
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "shape": "example.dynamodb.QueryOutput"
      }
    }
  ]
}
